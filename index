<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My English Journey — A1 Present Simple Workbook</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=DM+Sans:wght@300;400;500;600&family=Caveat:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#FEFCFA;--white:#FFFFFF;
  --lila:#C9B8E8;--lila-pale:#F2EEFB;--lila-deep:#7B5EA7;--lila-dark:#4A3475;
  --pink:#F0A8C4;--pink-pale:#FEF0F6;--pink-deep:#C2587F;--pink-dark:#8A2E50;
  --yellow:#FADA85;--yellow-pale:#FFFAEB;--yellow-dark:#7A5500;--yellow-mid:#F5C430;
  --orange:#FFAD7A;--orange-pale:#FFF3EB;--orange-dark:#9C4418;--orange-mid:#F07830;
  --gray:#9E9BAD;--gray-pale:#F5F4F8;--gray-dark:#4A4660;--gray-mid:#6B6585;
  --text:#2D2840;--text-mid:#6B6585;--border:#E8E2F2;--border-mid:#D4CDE8;
  --success:#5BAD7F;--success-pale:#EAF8F0;--error:#E0556A;--error-pale:#FEF0F2;
}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);line-height:1.65;font-size:15px;}

/* STICKY HEADER */
.sticky-header{position:sticky;top:0;z-index:100;background:rgba(254,252,250,.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:10px 24px;display:flex;align-items:center;gap:16px;}
.header-logo{font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:var(--lila-deep);white-space:nowrap;}
.progress-wrap{flex:1;}
.progress-label{display:flex;justify-content:space-between;font-size:11px;color:var(--gray-mid);margin-bottom:4px;}
.progress-bar{height:7px;background:var(--lila-pale);border-radius:10px;overflow:hidden;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--lila-deep),var(--pink-deep));border-radius:10px;transition:width .5s ease;width:0%;}
.header-score{font-size:13px;font-weight:600;color:var(--lila-deep);white-space:nowrap;}

/* LAYOUT */
.container{max-width:820px;margin:0 auto;padding:32px 24px 80px;}

/* COVER */
.cover{background:linear-gradient(140deg,#F2EEFB 0%,#FEF0F6 45%,#FFFAEB 80%,#FFF3EB 100%);border-radius:28px;padding:56px 44px;text-align:center;margin-bottom:40px;position:relative;overflow:hidden;border:1px solid var(--border);}
.cover::before{content:'🌸';position:absolute;top:18px;left:24px;font-size:40px;opacity:.15;transform:rotate(-20deg);}
.cover::after{content:'✦';position:absolute;bottom:22px;right:28px;font-size:38px;opacity:.12;transform:rotate(15deg);}
.cover-badge{display:inline-block;background:var(--lila);color:var(--lila-dark);font-size:11px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;padding:5px 18px;border-radius:30px;margin-bottom:22px;}
.cover h1{font-family:'Playfair Display',serif;font-size:clamp(34px,6vw,62px);font-weight:700;color:var(--text);line-height:1.1;margin-bottom:10px;}
.cover h1 em{color:var(--lila-deep);font-style:italic;}
.cover-sub{font-size:15px;color:var(--text-mid);font-weight:300;max-width:460px;margin:0 auto 26px;}
.cover-pills{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:26px;}
.pill{padding:6px 16px;border-radius:20px;font-size:12px;font-weight:500;}
.pill-lila{background:var(--lila-pale);color:var(--lila-dark);}
.pill-pink{background:var(--pink-pale);color:var(--pink-dark);}
.pill-orange{background:var(--orange-pale);color:var(--orange-dark);}
.pill-yellow{background:var(--yellow-pale);color:var(--yellow-dark);}
.name-box{display:inline-block;background:rgba(255,255,255,.8);border:1.5px solid var(--border-mid);border-radius:18px;padding:16px 28px;}
.name-box label{font-size:11px;color:var(--gray);letter-spacing:2px;text-transform:uppercase;display:block;margin-bottom:8px;}
.name-box input{border:none;border-bottom:2px solid var(--lila);background:transparent;font-size:16px;font-family:'DM Sans',sans-serif;color:var(--text);padding:2px 0;outline:none;width:220px;text-align:center;}

/* UNIT HEADERS */
.unit-header{border-radius:24px;padding:36px 36px 28px;margin-bottom:28px;position:relative;overflow:hidden;}
.u1{background:linear-gradient(135deg,#F2EEFB 0%,#FEF0F6 100%);border:1px solid var(--lila);}
.u2{background:linear-gradient(135deg,#FFF3EB 0%,#FFFAEB 100%);border:1px solid var(--orange);}
.u3{background:linear-gradient(135deg,#FEF0F6 0%,#F2EEFB 100%);border:1px solid var(--pink);}
.u4{background:linear-gradient(135deg,#FFFAEB 0%,#FFF3EB 100%);border:1px solid var(--yellow-mid);}
.u5{background:linear-gradient(135deg,#F5F4F8 0%,#F2EEFB 100%);border:1px solid var(--lila);}
.unit-header::after{position:absolute;bottom:14px;right:22px;font-size:52px;opacity:.12;pointer-events:none;}
.u1::after{content:'💜';}.u2::after{content:'🧡';}.u3::after{content:'🚫';}.u4::after{content:'❓';}.u5::after{content:'✨';}
.unit-tag{font-size:10px;font-weight:600;letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:8px;}
.u1 .unit-tag{color:var(--lila-deep);}
.u2 .unit-tag{color:var(--orange-dark);}
.u3 .unit-tag{color:var(--pink-deep);}
.u4 .unit-tag{color:var(--yellow-dark);}
.u5 .unit-tag{color:var(--lila-deep);}
.unit-header h2{font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,36px);font-weight:700;color:var(--text);margin-bottom:8px;}
.unit-header p{font-size:14px;color:var(--text-mid);max-width:500px;}
.unit-meta{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;}
.unit-meta span{background:rgba(255,255,255,.7);border-radius:20px;padding:4px 14px;font-size:12px;border:1px solid var(--border);}

/* SECTION LABEL */
.sec-label{display:flex;align-items:center;gap:12px;margin:32px 0 14px;}
.sec-icon{width:36px;height:36px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
.si-lila{background:var(--lila-pale);} .si-pink{background:var(--pink-pale);} .si-yellow{background:var(--yellow-pale);} .si-orange{background:var(--orange-pale);} .si-gray{background:var(--gray-pale);}
.sec-label-text span{font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--gray);display:block;}
.sec-label-text h3{font-size:17px;font-weight:600;color:var(--text);margin:0;}

/* CALLOUTS */
.callout{display:flex;gap:14px;align-items:flex-start;border-radius:16px;padding:15px 18px;margin-bottom:18px;}
.callout-emoji{font-size:20px;flex-shrink:0;margin-top:1px;}
.callout-lila{background:var(--lila-pale);border:1px solid rgba(201,184,232,.5);}
.callout-pink{background:var(--pink-pale);border:1px solid rgba(240,168,196,.5);}
.callout-yellow{background:var(--yellow-pale);border:1px solid rgba(250,218,133,.5);}
.callout-orange{background:var(--orange-pale);border:1px solid rgba(255,173,122,.5);}
.callout strong{font-size:13px;display:block;margin-bottom:3px;color:var(--text);}
.callout p{font-size:13.5px;color:var(--text);line-height:1.6;margin:0;}

/* GRAMMAR BOX */
.grammar-box{background:var(--gray-dark);color:white;border-radius:20px;padding:24px;margin-bottom:20px;}
.grammar-tag{font-size:10px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--yellow);display:block;margin-bottom:14px;}
.grammar-box h4{color:white;font-size:15px;margin-bottom:12px;}
.grammar-rule{background:rgba(255,255,255,.1);border-radius:12px;padding:14px 16px;margin-bottom:10px;border:1px solid rgba(255,255,255,.1);}
.grammar-rule:last-child{margin-bottom:0;}
.grammar-rule .rule-label{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--lila);margin-bottom:6px;display:block;}
.grammar-rule .rule-text{font-size:14px;line-height:1.7;}
.grammar-rule .rule-text em{color:var(--yellow);font-style:normal;font-weight:600;}
.grammar-rule .rule-text s{color:var(--error);opacity:.8;}
.grammar-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px;}
.grammar-grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:12px;}

/* BIG FORMULA */
.formula{background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.25);border-radius:16px;padding:18px 20px;margin:14px 0;text-align:center;font-size:17px;font-weight:600;letter-spacing:.5px;}
.formula em{color:var(--yellow);font-style:normal;}
.formula span{color:var(--pink);font-size:13px;display:block;margin-top:4px;font-weight:400;opacity:.8;}

/* CONJUGATION TABLE */
.conj-table{width:100%;border-collapse:collapse;border-radius:16px;overflow:hidden;margin-bottom:18px;border:1px solid var(--border);}
.conj-table th{background:var(--lila-deep);color:white;padding:10px 14px;font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:left;}
.conj-table td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:14px;background:var(--white);}
.conj-table tr:last-child td{border-bottom:none;}
.conj-table tr:nth-child(even) td{background:var(--lila-pale);}
.conj-table .subject{font-weight:600;color:var(--lila-deep);}
.conj-table .verb{font-weight:600;color:var(--text);}
.conj-table .example{color:var(--text-mid);font-size:13px;font-style:italic;}
.conj-highlight{background:var(--orange-pale)!important;border-left:3px solid var(--orange-mid);}
.conj-table .rule-note{font-size:11.5px;color:var(--orange-dark);font-weight:600;font-style:normal;}

/* EXERCISE CARD */
.exercise{background:var(--white);border:1px solid var(--border);border-radius:20px;padding:24px;margin-bottom:18px;}
.exercise-header{display:flex;align-items:center;gap:10px;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border);}
.ex-num{width:30px;height:30px;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;}
.ex-num.lila{background:var(--lila-deep);}
.ex-num.orange{background:var(--orange-mid);}
.ex-num.pink{background:var(--pink-deep);}
.ex-num.yellow{background:var(--yellow-dark);}
.ex-num.gray{background:var(--gray-dark);}
.ex-type{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--gray);}
.exercise-header h4{font-size:15px;font-weight:600;color:var(--text);margin:0;}

/* FILL IN THE BLANK */
.blank-sentence{font-size:15px;line-height:3;margin-bottom:4px;display:block;}
.blank{display:inline-block;border:none;border-bottom:2.5px solid var(--lila);background:var(--lila-pale);padding:2px 10px;min-width:90px;font-size:15px;font-family:'DM Sans',sans-serif;color:var(--text);outline:none;border-radius:4px 4px 0 0;transition:.2s;text-align:center;}
.blank:focus{border-bottom-color:var(--lila-deep);}
.blank.correct{border-bottom-color:var(--success);background:var(--success-pale);color:var(--success);}
.blank.wrong{border-bottom-color:var(--error);background:var(--error-pale);color:var(--error);}
.blank.pink{border-bottom-color:var(--pink);background:var(--pink-pale);}
.blank.pink:focus{border-bottom-color:var(--pink-deep);}
.blank.orange{border-bottom-color:var(--orange);background:var(--orange-pale);}
.blank.orange:focus{border-bottom-color:var(--orange-dark);}
.blank.yellow{border-bottom-color:var(--yellow-mid);background:var(--yellow-pale);}
.blank.yellow:focus{border-bottom-color:var(--yellow-dark);}

/* BUTTONS */
.btn{border:none;border-radius:12px;padding:10px 22px;font-size:13px;font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;transition:.18s;display:inline-flex;align-items:center;gap:6px;}
.btn-lila{background:var(--lila-pale);color:var(--lila-dark);border:1.5px solid var(--lila);}
.btn-lila:hover{background:var(--lila);color:var(--lila-dark);}
.btn-check{background:var(--lila-deep);color:white;}
.btn-check:hover{background:var(--lila-dark);}
.btn-show{background:var(--gray-pale);color:var(--gray-dark);border:1.5px solid var(--border);}
.btn-show:hover{background:var(--border);}
.btn-reset{background:transparent;color:var(--gray);border:1.5px dashed var(--border);font-size:12px;padding:7px 14px;}
.btn-reset:hover{border-color:var(--gray);}
.btn-orange{background:var(--orange-pale);color:var(--orange-dark);border:1.5px solid var(--orange);}
.btn-orange:hover{background:var(--orange);}
.btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center;}

/* ANSWER REVEAL */
.answer-reveal{display:none;margin-top:14px;background:var(--success-pale);border:1.5px solid var(--success);border-radius:14px;padding:14px 16px;}
.answer-reveal.show{display:block;}
.ar-label{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--success);margin-bottom:8px;display:block;}
.answer-reveal li{font-size:14px;color:var(--text);margin-bottom:4px;list-style:none;display:flex;gap:8px;align-items:flex-start;}
.answer-reveal li::before{content:'✓';color:var(--success);font-weight:700;flex-shrink:0;}

/* RESULT BANNER */
.result-banner{display:none;border-radius:12px;padding:12px 16px;margin-top:12px;font-size:13.5px;font-weight:500;}
.result-banner.show{display:block;}
.result-good{background:var(--success-pale);color:var(--success);border:1px solid var(--success);}
.result-bad{background:var(--error-pale);color:var(--error);border:1px solid var(--error);}
.result-ok{background:var(--yellow-pale);color:var(--yellow-dark);border:1px solid var(--yellow-mid);}

/* MULTIPLE CHOICE */
.mc-q{font-size:14.5px;font-weight:600;color:var(--text);margin-bottom:12px;line-height:1.5;}
.mc-option{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1.5px solid var(--border);border-radius:14px;margin-bottom:8px;cursor:pointer;transition:.15s;font-size:14px;}
.mc-option:hover{border-color:var(--lila);background:var(--lila-pale);}
.mc-option.selected{border-color:var(--lila-deep);background:var(--lila-pale);}
.mc-option.correct-ans{border-color:var(--success);background:var(--success-pale);}
.mc-option.wrong-ans{border-color:var(--error);background:var(--error-pale);}
.mc-letter{width:28px;height:28px;border:1.5px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;transition:.15s;}
.mc-option.selected .mc-letter{background:var(--lila-deep);border-color:var(--lila-deep);color:white;}
.mc-option.correct-ans .mc-letter{background:var(--success);border-color:var(--success);color:white;}
.mc-option.wrong-ans .mc-letter{background:var(--error);border-color:var(--error);color:white;}
.mc-sep{height:1px;background:var(--border);margin:16px 0;}

/* TRUE/FALSE */
.tf-item{display:flex;gap:14px;align-items:center;padding:14px;border:1.5px solid var(--border);border-radius:14px;margin-bottom:10px;}
.tf-text{flex:1;font-size:14px;line-height:1.5;}
.tf-btns{display:flex;gap:8px;flex-shrink:0;}
.tf-btn{padding:6px 16px;border-radius:10px;border:1.5px solid var(--border);background:var(--gray-pale);font-size:12px;font-weight:600;cursor:pointer;transition:.15s;font-family:'DM Sans',sans-serif;}
.tf-btn:hover{border-color:var(--lila);}
.tf-btn.correct{background:var(--success-pale);border-color:var(--success);color:var(--success);}
.tf-btn.wrong{background:var(--error-pale);border-color:var(--error);color:var(--error);}

/* MATCHING */
.match-container{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
.match-col h5{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--gray);margin-bottom:10px;}
.match-item{padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;cursor:pointer;transition:.15s;user-select:none;background:var(--white);line-height:1.4;}
.match-item:hover{border-color:var(--pink);}
.match-item.selected{border-color:var(--lila-deep);background:var(--lila-pale);}
.match-item.matched{border-color:var(--success);background:var(--success-pale);cursor:default;}
.match-item.wrong-match{border-color:var(--error);background:var(--error-pale);}

/* REORDER */
.reorder-words{display:flex;flex-wrap:wrap;gap:8px;min-height:48px;background:var(--lila-pale);border-radius:14px;padding:12px;margin-bottom:10px;border:2px dashed var(--border);}
.reorder-result{display:flex;flex-wrap:wrap;gap:8px;min-height:52px;background:var(--white);border:2px solid var(--border);border-radius:14px;padding:12px;margin-bottom:10px;}
.word-tile{padding:7px 14px;border-radius:12px;font-size:14px;font-weight:500;cursor:pointer;transition:.15s;border:1.5px solid;}
.tile-source{background:var(--white);border-color:var(--lila);color:var(--lila-dark);}
.tile-source:hover{background:var(--lila-pale);}
.tile-placed{background:var(--lila-pale);border-color:var(--lila-deep);color:var(--lila-dark);}
.tile-placed:hover{background:var(--lila);}
.reorder-label{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--gray);margin-bottom:8px;display:block;}

/* WORD BANK */
.word-bank{display:flex;flex-wrap:wrap;gap:8px;padding:14px 16px;background:var(--lila-pale);border:1.5px solid var(--lila);border-radius:14px;margin-bottom:16px;}
.wb-label{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--lila-dark);width:100%;margin-bottom:4px;}
.word-chip{padding:6px 14px;background:var(--white);border:1.5px solid var(--lila);border-radius:20px;font-size:13px;font-weight:500;color:var(--lila-dark);cursor:pointer;transition:.15s;}
.word-chip:hover{background:var(--lila);border-color:var(--lila-deep);}

/* WRITING BOX */
.writing-box{width:100%;min-height:100px;border:2px solid var(--border);border-radius:16px;padding:14px 16px;font-size:14px;font-family:'DM Sans',sans-serif;color:var(--text);outline:none;resize:vertical;background:var(--bg);transition:.2s;line-height:1.65;}
.writing-box:focus{border-color:var(--lila-deep);background:var(--white);}
.writing-box.tall{min-height:140px;}
.char-count{font-size:11px;color:var(--gray);margin-top:6px;text-align:right;}

/* CHECKBOX ACTIVITY */
.check-q{background:var(--gray-dark);color:white;border-radius:14px;padding:13px 16px;margin-bottom:10px;font-size:15px;font-weight:500;}
.check-opts{margin-bottom:20px;}
.check-opt{display:flex;align-items:flex-start;gap:12px;padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;margin-bottom:7px;cursor:pointer;transition:.15s;font-size:14px;background:var(--white);}
.check-opt:hover{border-color:var(--lila);background:var(--lila-pale);}
.check-opt.selected{border-color:var(--lila-deep);background:var(--lila-pale);}
.check-box{width:20px;height:20px;border-radius:6px;border:2px solid var(--border);flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;transition:.15s;font-size:12px;font-weight:700;}
.check-opt.selected .check-box{background:var(--lila-deep);border-color:var(--lila-deep);color:white;}

/* VOCAB CARDS */
.vocab-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:12px;margin-bottom:18px;}
.vocab-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:15px;cursor:pointer;transition:.18s;text-align:center;min-height:90px;display:flex;flex-direction:column;justify-content:center;}
.vocab-card:hover{border-color:var(--orange);transform:translateY(-2px);}
.vocab-card.flipped{background:var(--orange-pale);border-color:var(--orange);}
.vocab-front .vword{font-size:16px;font-weight:600;color:var(--text);margin-bottom:4px;}
.vocab-front .vpron{font-family:'Caveat',cursive;font-size:16px;color:var(--orange-mid);}
.vocab-front .vhint{font-size:11px;color:var(--gray);margin-top:6px;}
.vocab-back{display:none;}
.vocab-card.flipped .vocab-front{display:none;}
.vocab-card.flipped .vocab-back{display:block;}
.vocab-back .vtranslate{font-size:15px;font-weight:600;color:var(--orange-dark);margin-bottom:4px;}
.vocab-back .vexample{font-size:12px;color:var(--text-mid);font-style:italic;line-height:1.4;}

/* SPEAKING CARDS */
.speaking-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;}
.speaking-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:16px;transition:.15s;}
.speaking-card:hover{border-color:var(--pink);}
.sc-num{font-family:'Caveat',cursive;font-size:22px;color:var(--pink);margin-bottom:6px;}
.speaking-card p{font-size:14px;color:var(--text);margin-bottom:10px;line-height:1.5;}
