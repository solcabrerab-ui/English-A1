<script>
let score=0;
function addScore(n){score+=n;document.getElementById('scoreDisplay').textContent=score;}

// PROGRESS
function trackProgress(){
  const all=[...document.querySelectorAll('input[type="text"], textarea, .my-answer')];
  const filled=all.filter(i=>i.value&&i.value.trim().length>0).length;
  const pct=all.length>0?Math.round((filled/all.length)*100):0;
  document.getElementById('progressFill').style.width=pct+'%';
  document.getElementById('progressText').textContent=pct+'% complete';
}
function updateCount(el,id){
  const w=el.value.trim().split(/\s+/).filter(x=>x).length;
  document.getElementById(id).textContent=el.value.length+' chars / ~'+w+' words';
  trackProgress();
}

// FILL BLANKS
function checkBlanks(prefix,answers,count,btn){
  let ok=0;
  const letters='abcdefghijklmnopqrstuvwxyz';
  answers.forEach((ans,i)=>{
    const el=document.getElementById(prefix+letters[i]);
    if(!el)return;
    const val=el.value.trim().toLowerCase().replace(/\s+/g,' ');
    const exp=ans.toLowerCase();
    if(val===exp){el.classList.add('correct');el.classList.remove('wrong');ok++;}
    else{el.classList.add('wrong');el.classList.remove('correct');}
  });
  const pct=Math.round((ok/answers.length)*100);
  const r=document.getElementById('res_'+prefix);
  if(r){
    r.className='result-banner show '+(pct===100?'result-good':pct>=60?'result-ok':'result-bad');
    r.textContent=pct===100?'✓ Perfect! All '+answers.length+' correct! +10 pts 🎉':'You got '+ok+'/'+answers.length+' correct. Review the highlighted ones.';
    if(pct===100)addScore(10);
    else if(pct>=60)addScore(5);
  }
  trackProgress();
}
function resetBlanks2(prefix,count){
  const letters='abcdefghijklmnopqrstuvwxyz';
  for(let i=0;i<count;i++){
    const el=document.getElementById(prefix+letters[i]);
    if(el){el.value='';el.classList.remove('correct','wrong');}
  }
  const r=document.getElementById('res_'+prefix);
  if(r)r.className='result-banner';
}

// SHOW/HIDE
function toggleAnswer(id){
  const el=document.getElementById(id);
  if(el)el.classList.toggle('show');
}

// MULTIPLE CHOICE
function doMC(el,group,chosen,correct){
  const opts=document.querySelectorAll('#'+group+' .mc-option');
  if(opts[0].dataset.done)return;
  opts.forEach(o=>{o.classList.remove('selected','correct-ans','wrong-ans');});
  el.classList.add('selected');
  if(chosen===correct){el.classList.add('correct-ans');addScore(4);}
  else{el.classList.add('wrong-ans');opts.forEach(o=>{if(o.querySelector('.mc-letter').textContent===correct)o.classList.add('correct-ans');});}
  opts.forEach(o=>o.dataset.done='1');
  trackProgress();
}

// TRUE/FALSE
function doTF(btn,correct){
  const item=btn.closest('.tf-item');
  if(item.dataset.done)return;
  const btns=item.querySelectorAll('.tf-btn');
  btns.forEach(b=>b.classList.remove('correct','wrong'));
  const chosen=btn.textContent;
  if(chosen===correct){btn.classList.add('correct');addScore(3);}
  else{btn.classList.add('wrong');btns.forEach(b=>{if(b.textContent===correct)b.classList.add('correct');});}
  item.dataset.done='1';
  trackProgress();
}

// VOCAB FLIP
function flipCard(c){c.classList.toggle('flipped');addScore(1);trackProgress();}

// MATCHING
let mLeft=null,mRight=null;
function doMatch(el,side,id){
  if(el.classList.contains('matched'))return;
  if(side==='left'){if(mLeft)mLeft.classList.remove('selected');mLeft=el;el.classList.add('selected');}
  else{if(mRight)mRight.classList.remove('selected');mRight=el;el.classList.add('selected');}
  if(mLeft&&mRight){
    const lid=mLeft.id.split('_')[1];
    const rid=mRight.id.split('_')[1];
    if(lid===rid){
      mLeft.classList.replace('selected','matched');
      mRight.classList.replace('selected','matched');
      addScore(4);
    }else{
      mLeft.classList.add('wrong-match');mRight.classList.add('wrong-match');
      const l=mLeft,r=mRight;
      setTimeout(()=>{l.classList.remove('selected','wrong-match');r.classList.remove('selected','wrong-match');},700);
    }
    mLeft=null;mRight=null;
  }
  trackProgress();
}
function resetAllMatch(){
  mLeft=null;mRight=null;
  document.querySelectorAll('.match-item').forEach(el=>el.classList.remove('matched','selected','wrong-match'));
}

// REORDER
function mw(el,fromId,toId){
  if(el.dataset.placed)return;
  const to=document.getElementById(toId);
  const clone=el.cloneNode(true);
  clone.className='word-tile tile-placed';
  clone.dataset.srcId=fromId;
  clone.dataset.srcEl=el.dataset.id||el.textContent;
  clone.onclick=function(){
    el.style.opacity='1';el.style.pointerEvents='auto';delete el.dataset.placed;
    clone.remove();trackProgress();
  };
  to.appendChild(clone);
  el.style.opacity='.3';el.style.pointerEvents='none';el.dataset.placed='1';
  trackProgress();
}
function checkRO(resultId,correct,btn,resId){
  const tiles=[...document.querySelectorAll('#'+resultId+' .word-tile')];
  const sentence=tiles.map(t=>t.textContent.trim()).join(' ');
  const res=document.getElementById(resId);
  if(sentence.toLowerCase()===correct.toLowerCase()){
    res.className='result-banner show result-good';
    res.textContent='✓ Perfect! "'+correct+'" +5 pts 🎉';
    addScore(5);
  }else{
    res.className='result-banner show result-bad';
    res.textContent='Not quite. Expected: "'+correct+'" — try again!';
  }
  trackProgress();
}
function resetRO(srcId,resId,banId){
  document.getElementById(resId).innerHTML='';
  document.querySelectorAll('#'+srcId+' .word-tile').forEach(t=>{t.style.opacity='1';t.style.pointerEvents='auto';delete t.dataset.placed;});
  const r=document.getElementById(banId);
  if(r)r.className='result-banner';
}

// CHECK OPT
function selOpt(el){
  const parent=el.closest('.check-opts');
  parent.querySelectorAll('.check-opt').forEach(o=>{o.classList.remove('selected');o.querySelector('.check-box').textContent='';});
  el.classList.add('selected');
  el.querySelector('.check-box').textContent='✓';
  addScore(1);
  trackProgress();
}

// REFLECT
function tickReflect(el){
  const s=el.querySelector('span');
  if(s.textContent==='☐'){s.textContent='✓';el.style.background='rgba(255,255,255,.28)';addScore(2);}
  else{s.textContent='☐';el.style.background='';}
  trackProgress();
}

// FINAL SCORE
function showFinalScore(){
  const el=document.getElementById('finalScore');
  el.innerHTML=score+'<span> pts</span>';
  const msg=score>=80?'Incredible work! You really know your Present Simple! 🏆':
             score>=55?'Great effort! You have a solid foundation. Keep practising! 💜':
             score>=30?'Good start! Review the grammar notes and try again. 🌸':
             'Every attempt counts! Go through the exercises again — you\'ll improve! 💛';
  const div=document.createElement('div');
  div.className='callout callout-lila';div.style='margin-top:16px;';
  div.innerHTML='<span style="font-size:22px">🌟</span><div><strong>'+msg+'</strong></div>';
  document.querySelector('.score-card').appendChild(div);
}

window.addEventListener('load',trackProgress);
</script>
</body>
